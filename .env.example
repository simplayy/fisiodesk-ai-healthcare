# Copia in .env per cambiare i default. Senza .env tutto gira in locale con Ollama, nessuna chiave richiesta.

# Provider del modello di chat (estrazione + interpretazione domande): ollama | google-genai | openai | anthropic | none
AI_CHAT_PROVIDER=ollama
# Provider degli embedding (ricerca semantica per condizioni fuori tassonomia): ollama | openai | none
AI_EMBEDDING_PROVIDER=ollama

# Modelli locali (Ollama). Per saltare il download: OLLAMA_MODELS=""
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
#OLLAMA_MODELS=qwen3.5:4b qwen3-embedding:0.6b

# Provider cloud (solo se selezionati sopra). Con un modello ospitato l'analisi delle note passa
# da ~20 s a meno di un secondo per nota, e le domande fuori vocabolario non scadono in timeout.
#GOOGLE_API_KEY=
#GOOGLE_CHAT_MODEL=gemini-2.5-flash-lite
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=

# "Oggi" per i filtri temporali. Vuoto = data dell'ultimo evento in calendario (2024-12-31 sul dataset).
#REFERENCE_DATE=2024-12-31

#APP_PORT=8080
